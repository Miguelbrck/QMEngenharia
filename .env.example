# Copie estas variáveis para o painel do seu host (Vercel > Settings > Environment Variables).
# NUNCA coloque a senha real dentro do código nem suba o .env para o GitHub.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seuemail@gmail.com
# Gmail: use uma "Senha de app" (Conta Google > Segurança > Verificação em duas etapas > Senhas de app)
SMTP_PASS=senha-de-app-aqui

# Remetente exibido ao cliente
MAIL_FROM="QM Engenharia <seuemail@gmail.com>"

# E-mail da equipe: recebe aviso de cada agendamento e as respostas dos clientes (opcional)
COMPANY_EMAIL=contato@qmengenharia.com.br
